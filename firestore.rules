rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /companies/{companyId} {
      allow read, write: if request.auth != null || companyId == 'demo-workspace-user';

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null || companyId == 'demo-workspace-user';
      }
    }
    
    // Fallback for users profile / metadata if needed
    match /users/{userId} {
      allow read, write: if (request.auth != null && request.auth.uid == userId) || userId == 'demo-workspace-user';
    }
  }
}

